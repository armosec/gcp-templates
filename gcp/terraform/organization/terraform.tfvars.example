# Organization-level GCP CDR deploy (SUB-7815). In production the ARMO backend
# generates this module block for you with these values already filled in.
#
# NOTE: this module is provider-less. Wrap it in a root that supplies a
# `provider "google"` block pinned to the security project (the ARMO backend
# generates one for you); do not add a provider block to the module itself.
#
# Keep access_key OUT of this file — pass it as TF_VAR_access_key instead:
#   export TF_VAR_access_key='...'

organization_id  = "123456789012"
security_project = "my-security-project"
region           = "us-central1"

customer_guid       = "00000000-0000-0000-0000-000000000000"
collector_image_ref = "quay.io/armosec/cdr-gcp:v0.1.0"

# Whole-org coverage (every current AND future child project) when omitted or
# empty. To scope to specific folders instead, list them — one sink is created per
# entry, and coverage is bounded to those folders' projects. "Excluding" a folder
# means simply not listing it: a log entry carries no folder ancestry, so folder
# exclusion is not expressible as a sink filter.
# include_folders = ["folders/111111111111", "folders/222222222222"]

# alert_export_url  = "https://report.armo.cloud/cloud/v1/cdrAlert"
# rule_endpoint_url = "https://report.armo.cloud/cloud/v1/cdrRules"
# name_prefix       = "armo-cdr"
